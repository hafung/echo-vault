{
  "name": "echo-vault",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:web": "tsc --noEmit && vite build",
    "build:server": "CGO_ENABLED=0 GOTOOLCHAIN=local go build -buildvcs=false -trimpath -ldflags=\"-s -w\" -o bin/echo-vault .",
    "build": "pnpm build:web && pnpm build:server",
    "start": "./bin/echo-vault",
    "sync": "./bin/echo-vault --sync-only",
    "test": "GOTOOLCHAIN=local go test -buildvcs=false ./...",
    "test:e2e": "playwright test",
    "test:links": "node --test tests/local-paths.unit.test.mjs"
  },
  "dependencies": {
    "dompurify": "^3.3.1",
    "lucide": "^0.468.0",
    "marked": "^17.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
